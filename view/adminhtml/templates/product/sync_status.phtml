<script>
    function toggleFields(btn) {
        var extra = btn.previousElementSibling;
        if (!extra) return;
        if (extra.style.display === 'none' || extra.style.display === '') {
            extra.style.display = 'inline-flex';
            btn.innerText = '<?= __('Show less') ?>';
            btn.classList.add('expanded');
        } else {
            extra.style.display = 'none';
            btn.innerText = '+' + btn.getAttribute('data-more-count') + ' <?= __('more') ?>';
            btn.classList.remove('expanded');
        }
    }

    require(['jquery'], function ($) {
        const syncUrl = '<?= $block->getSyncUrl() ?>';
        const productId = '<?= $productId ?>';

        $('#nexoraiq-sync-now-btn').click(function () {
            const btn = $(this);
            const text = btn.find('.btn-text');
            const spinner = btn.find('.btn-spinner');

            btn.prop('disabled', true);
            text.text('<?= __('Syncing product...') ?>');
            spinner.show();

            $.ajax({
                url: syncUrl,
                type: 'POST',
                data: {
                    product_id: productId,
                    form_key: window.FORM_KEY
                },
                dataType: 'json',
                success: function (response) {
                    if (response && response.success) {
                        text.text('<?= __('Success! Reloading...') ?>');
                        setTimeout(function () {
                            window.location.reload();
                        }, 800);
                    } else {
                        alert(response.message || '<?= __('Sync failed. Please check system.log') ?>');
                        btn.prop('disabled', false);
                        text.text('<?= __('Sync Now to NexorAIQ') ?>');
                        spinner.hide();
                    }
                },
                error: function (xhr, status, error) {
                    alert('<?= __('An error occurred while calling the sync endpoint.') ?> (' + error + ')');
                    btn.prop('disabled', false);
                    text.text('<?= __('Sync Now to NexorAIQ') ?>');
                    spinner.hide();
                }
            });
        });
    });
</script>
