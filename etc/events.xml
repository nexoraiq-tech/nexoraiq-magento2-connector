<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="catalog_product_save_after">
        <observer name="nexoraiq_product_save" instance="NexorAIQ\Connector\Observer\ProductSaveAfter"/>
    </event>
    <event name="catalog_product_delete_after_done">
        <observer name="nexoraiq_product_delete" instance="NexorAIQ\Connector\Observer\ProductDeleteAfter"/>
    </event>
    <event name="cataloginventory_stock_item_save_after">
        <observer name="nexoraiq_stock_update" instance="NexorAIQ\Connector\Observer\StockUpdateAfter"/>
    </event>
</config>
