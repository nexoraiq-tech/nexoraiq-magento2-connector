<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <nexoraiq>
            <general>
                <enabled>1</enabled>
                <connection_key></connection_key>
                <api_url>https://api.nexoraiq.tech</api_url>
                <realtime_sync>1</realtime_sync>
                <batch_size>100</batch_size>
                <full_reindex_skip_window>30</full_reindex_skip_window>
            </general>
            <attributes_config>
                <extra_attributes></extra_attributes>
            </attributes_config>
            <description_config>
                <ignore_description>0</ignore_description>
                <common_words></common_words>
            </description_config>
            <brands_config>
                <is_multi_brand>1</is_multi_brand>
                <identified_using>attribute</identified_using>
                <attribute>manufacturer</attribute>
                <is_brand_mandatory>0</is_brand_mandatory>
            </brands_config>
            <storefront_ui>
                <takeover_enabled>0</takeover_enabled>
                <search_type>keyword</search_type>
                <input_selector>#search</input_selector>
                <search_container>.columns</search_container>
                <search_layout>autocomplete</search_layout>
                <mobile_search_layout>autocomplete</mobile_search_layout>
                <autocomplete_limit>10</autocomplete_limit>
                <overlay_products_limit>20</overlay_products_limit>
                <overlay_layout_type>2columns</overlay_layout_type>
                <suggestions_enabled>1</suggestions_enabled>
                <suggestions_label>Suggestions</suggestions_label>
                <suggestions_limit>5</suggestions_limit>
                <categories_enabled>1</categories_enabled>
                <categories_label>Categories</categories_label>
                <categories_limit>5</categories_limit>
                <brands_enabled>1</brands_enabled>
                <brands_label>Brands</brands_label>
                <brands_limit>5</brands_limit>
            </storefront_ui>
            <search_page>
                <enabled>1</enabled>
                <route>search</route>
                <per_page>24</per_page>
                <show_filters>1</show_filters>
            </search_page>
            <add_to_cart>
                <show_on_overlay>1</show_on_overlay>
                <show_on_search_page>1</show_on_search_page>
                <button_label>Add to Cart</button_label>
                <after_add>drawer</after_add>
            </add_to_cart>
        </nexoraiq>
    </default>
</config>
